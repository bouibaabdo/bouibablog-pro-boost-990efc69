# =========================================================================
# المرحلة 1: مرحلة بناء التطبيق (Build Stage)
# =========================================================================
FROM node:20-alpine AS builder

WORKDIR /app

# نسخ ملفات الاعتمادات
COPY package*.json ./

# تثبيت جميع الاعتمادات بما فيها الخاصة بالبناء والتطوير
RUN npm ci

# نسخ باقي كود المشروع
COPY . .

# تحديد هدف البناء ليكون خادم Node.js مناسباً لبيئة الـ Docker (بدلاً من Cloudflare Pages)
ENV NITRO_PRESET=node-server

# بناء التطبيق
RUN npm run build

# =========================================================================
# المرحلة 2: مرحلة التشغيل (Runtime Stage)
# =========================================================================
FROM node:20-alpine AS runner

WORKDIR /app

# تهيئة بيئة التشغيل للإنتاج وتحديد منفذ الاستماع الافتراضي لـ Cloud Run
ENV NODE_ENV=production
ENV PORT=8080

# نسخ المخرجات الجاهزة فقط من مرحلة البناء لتقليل حجم الحاوية لأقصى درجة
COPY --from=builder /app/.output ./.output

# فتح منفذ الاستماع
EXPOSE 8080

# تشغيل خادم Nitro المدمج
CMD ["node", ".output/server/index.mjs"]
